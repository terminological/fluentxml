<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.terminological</groupId>
		<artifactId>m2repo</artifactId>
		<version>0.0.6</version>
	</parent>

	<artifactId>fluentxml-parent</artifactId>
	<version>2.0.0</version>
	<packaging>pom</packaging>

	<name>FluentXML parent</name>
	<description>Aggregator for the FluentXML library and its Maven plugin</description>

	<modules>
		<module>library</module>
		<module>maven-plugin</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<git.repo>terminological/fluentxml</git.repo>
		<maven.compiler.release>11</maven.compiler.release>
	</properties>

	<repositories>
		<repository>
			<id>sonatype-snapshots</id>
			<url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>

	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/terminological/fluentxml/issues</url>
	</issueManagement>

	<!--
		Declared here rather than inherited from m2repo. maven-release-plugin records an inherited
		scm as empty and then builds a per-project url by appending the artifactId to the parent's,
		which produced scm.url=scm:git:git@github.com:terminological/fluentxml.git/fluentxml-parent
		and made release:perform die with "not a valid repository name".
	-->
	<scm>
		<connection>scm:git:git@github.com:${git.repo}.git</connection>
		<developerConnection>scm:git:git@github.com:${git.repo}.git</developerConnection>
		<url>https://github.com/${git.repo}</url>
	  <tag>fluentxml-parent-2.0.0</tag>
  </scm>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
				<configuration>
					<release>${maven.compiler.release}</release>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.12.0</version>
				<configuration>
					<doclint>none</doclint>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
